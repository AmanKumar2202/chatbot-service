SERVICE_API_KEY=replace-with-a-long-random-service-secret
SERVICE_ROLE=all
MAX_MESSAGE_LENGTH=5000
MAX_HISTORY_MESSAGES=50
RATE_LIMIT=60/minute
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1
WEBSOCKET_CONNECTION_RATE_LIMIT=10/minute
WEBSOCKET_MESSAGE_RATE_LIMIT=60/minute
WEBSOCKET_IDLE_TIMEOUT_SECONDS=60
MAX_REQUEST_BODY_BYTES=2100000
SERVER_LIMIT_CONCURRENCY=200
CORS_ORIGINS=http://localhost:8000,http://localhost:5173
CONFIDENCE_THRESHOLD=0.55
RAG_EMBEDDING_BACKEND=sentence_transformers
RAG_VECTOR_BACKEND=chroma
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHROMA_HOST=localhost
RAG_CHROMA_PORT=8001
RAG_CHROMA_SSL=false
RAG_CHROMA_TENANT=default_tenant
RAG_CHROMA_DATABASE=default_database
RAG_MAX_DOCUMENTS_PER_USER=100
RAG_MAX_CHUNKS_PER_USER=5000
RAG_WARMUP_ON_STARTUP=false
TORCH_NUM_THREADS=1
ARGOS_DATA_DIRECTORY=./argos_data
ARGOS_LANGUAGE_PAIRS=
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TOP_K=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
STREAM_CHUNK_WORDS=8
STREAM_DELAY_MS=0
STREAM_MAX_DURATION_SECONDS=30
